{
  "id": null,
  "uid": "llm-router-stack-extended",
  "title": "LLM Router Stack — Painel Interativo (Drill-Down)",
  "tags": ["llm", "router", "nsga", "grafana", "jefferson"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(model_cost_usd, model)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "judge",
        "label": "Juiz",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(judge_quality_score_mean, judge)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "metric_group",
        "label": "Métrica",
        "type": "custom",
        "query": "Latência,Custo,Qualidade,Fitness,Cache",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📊 Visão Geral — $metric_group",
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "⏱️ Latência Média por Modelo",
      "targets": [
        {
          "expr": "model_latency_seconds_avg{model=~\"$model\"}",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "x": 0, "y": 1, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "💰 Custo por 1k tokens",
      "targets": [
        {
          "expr": "model_cost_usd{model=~\"$model\"}",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "x": 9, "y": 1, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "🧠 Nota Média dos Juízes",
      "targets": [
        {
          "expr": "judge_quality_score_mean{judge=~\"$judge\"}",
          "legendFormat": "{{judge}}"
        }
      ],
      "gridPos": { "x": 0, "y": 7, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "⚙️ Pesos NSGA-II por Modelo",
      "targets": [
        {
          "expr": "nsga_weight_current{model=~\"$model\"}",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "x": 9, "y": 7, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "📈 Fitness e Recompensas (NSGA-II)",
      "targets": [
        {
          "expr": "nsga_last_fitness_mean",
          "legendFormat": "Fitness médio"
        },
        {
          "expr": "nsga_generations_total",
          "legendFormat": "Gerações"
        }
      ],
      "gridPos": { "x": 0, "y": 13, "w": 18, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "📦 Cache HIT vs MISS (Semântico)",
      "targets": [
        {
          "expr": "rate(semantic_cache_hits_total[5m])",
          "legendFormat": "HIT"
        },
        {
          "expr": "rate(semantic_cache_misses_total[5m])",
          "legendFormat": "MISS"
        }
      ],
      "gridPos": { "x": 0, "y": 19, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "🔁 Execução NSGA-II (Tempo e Convergência)",
      "targets": [
        {
          "expr": "nsga_execution_time_seconds",
          "legendFormat": "Execução (s)"
        },
        {
          "expr": "nsga_convergence_ratio",
          "legendFormat": "Convergência"
        }
      ],
      "gridPos": { "x": 9, "y": 19, "w": 9, "h": 6 }
    },
    {
      "type": "row",
      "title": "🔍 Drill-Down por Modelo ($model)",
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Latência — Detalhe por Modelo",
      "targets": [
        {
          "expr": "model_latency_seconds_avg{model=~\"$model\"}",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "x": 0, "y": 25, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Custo — Detalhe por Modelo",
      "targets": [
        {
          "expr": "model_cost_usd{model=~\"$model\"}",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": { "x": 9, "y": 25, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Juízes — Notas por Modelo",
      "targets": [
        {
          "expr": "judge_quality_score_mean{model=~\"$model\", judge=~\"$judge\"}",
          "legendFormat": "{{judge}}"
        }
      ],
      "gridPos": { "x": 0, "y": 31, "w": 18, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "NSGA-II — Fitness e Pesos Detalhados",
      "targets": [
        {
          "expr": "nsga_weight_current{model=~\"$model\"}",
          "legendFormat": "Peso atual"
        },
        {
          "expr": "nsga_last_fitness_mean{model=~\"$model\"}",
          "legendFormat": "Fitness"
        }
      ],
      "gridPos": { "x": 0, "y": 37, "w": 18, "h": 6 }
    },
    {
      "type": "row",
      "title": "🧩 Infraestrutura e Desempenho",
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Redis Ops/s",
      "targets": [
        {"expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "Comandos/s"}
      ],
      "gridPos": { "x": 0, "y": 43, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "Conexões MariaDB",
      "targets": [
        {"expr": "mariadb_threads_connected", "legendFormat": "Threads"}
      ],
      "gridPos": { "x": 9, "y": 43, "w": 9, "h": 6 }
    }
  ]
}

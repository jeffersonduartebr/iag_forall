{
  "title": "LLM Router \u2013 Model Performance Overview",
  "uid": "llm-router-model-performance",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Latency & Quality",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by model",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(candidate_latency_seconds_bucket[5m])) by (le, model))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average quality score (judge_score)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "rate(judge_score_sum[5m]) / rate(judge_score_count[5m])"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cost & Volume",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Cost per model (USD/min)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum(rate(candidate_estimated_cost_usd_sum[5m])) by (model)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per model (5m)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "increase(router_chosen_model_total[5m])"
        }
      ]
    }
  ]
}
{
  "id": null,
  "title": "LLM Router Stack — Monitoramento Geral",
  "uid": "llm-router-stack",
  "tags": ["llm", "nsga", "router", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "🚦 Status Geral",
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Última Execução NSGA-II",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nsga_last_run_timestamp",
          "legendFormat": "Última execução (epoch)"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["last"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none"
      },
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4}
    },
    {
      "type": "graph",
      "title": "📊 Latência Média por Modelo",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "model_latency_seconds_avg",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": {"x": 6, "y": 1, "w": 9, "h": 6}
    },
    {
      "type": "graph",
      "title": "💰 Custo Médio por 1k tokens (por modelo)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "model_cost_per_1k_tokens",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": {"x": 0, "y": 7, "w": 9, "h": 6}
    },
    {
      "type": "graph",
      "title": "🧠 Qualidade Média (juízes)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "judge_quality_score_mean",
          "legendFormat": "{{judge}}"
        }
      ],
      "gridPos": {"x": 9, "y": 7, "w": 9, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "⚙️ Peso Atual NSGA-II por Modelo",
      "targets": [
        {
          "expr": "nsga_weight_current",
          "legendFormat": "{{model}}"
        }
      ],
      "gridPos": {"x": 0, "y": 13, "w": 18, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "📈 Rewards e Fitness (NSGA-II)",
      "targets": [
        {
          "expr": "nsga_last_fitness_mean",
          "legendFormat": "Fitness médio"
        },
        {
          "expr": "nsga_generations_total",
          "legendFormat": "Gerações acumuladas"
        }
      ],
      "gridPos": {"x": 0, "y": 19, "w": 18, "h": 6}
    },
    {
      "type": "graph",
      "title": "🧩 Taxa de Cache HIT/MISS (Semântico)",
      "targets": [
        {
          "expr": "rate(semantic_cache_hits_total[5m])",
          "legendFormat": "HITs"
        },
        {
          "expr": "rate(semantic_cache_misses_total[5m])",
          "legendFormat": "MISSes"
        }
      ],
      "gridPos": {"x": 0, "y": 25, "w": 9, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "🧮 Execução Média NSGA (segundos)",
      "targets": [
        {
          "expr": "nsga_execution_time_seconds",
          "legendFormat": "Tempo Execução"
        }
      ],
      "gridPos": {"x": 9, "y": 25, "w": 9, "h": 6}
    },
    {
      "type": "row",
      "title": "📦 Infraestrutura — Redis, DB e API",
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Redis Ops/s",
      "targets": [
        {"expr": "rate(redis_commands_processed_total[5m])", "legendFormat": "Comandos/s"}
      ],
      "gridPos": {"x": 0, "y": 31, "w": 9, "h": 6}
    },
    {
      "type": "timeseries",
      "title": "Conexões MariaDB",
      "targets": [
        {"expr": "mariadb_threads_connected", "legendFormat": "Threads"}
      ],
      "gridPos": {"x": 9, "y": 31, "w": 9, "h": 6}
    },
    {
      "type": "graph",
      "title": "📡 Latência API (Router)",
      "targets": [
        {"expr": "rate(http_requests_total[1m])", "legendFormat": "Req/s"}
      ],
      "gridPos": {"x": 0, "y": 37, "w": 18, "h": 6}
    }
  ]
}

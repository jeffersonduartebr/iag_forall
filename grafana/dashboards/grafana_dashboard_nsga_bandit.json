{
  "id": null,
  "uid": "nsga-bandit-router",
  "title": "Router — NSGA-II + Bandit (Híbrido)",
  "tags": ["router", "nsga", "bandit", "llm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "row",
      "title": "Visão Geral",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "type": "stat",
      "title": "Chamadas Totais (por provedor)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by(model) (providers_model_requests_total)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 1},
      "options": {"reduceOptions": {"calcs": ["last"]}, "orientation": "horizontal"}
    },
    {
      "type": "timeseries",
      "title": "Latência por Modelo",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(providers_model_latency_seconds_sum[5m]) / rate(providers_model_latency_seconds_count[5m])",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 1},
      "options": {"legend": {"displayMode": "table"}}
    },
    {
      "type": "row",
      "title": "NSGA-II",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Pesos NSGA por Modelo",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nsga_model_weight",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10}
    },
    {
      "type": "stat",
      "title": "Melhor Latência (NSGA) [s]",
      "datasource": "Prometheus",
      "targets": [{"expr": "nsga_best_latency_seconds", "refId": "A"}],
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 10}
    },
    {
      "type": "stat",
      "title": "Melhor Custo (NSGA) [$ / 1k]",
      "datasource": "Prometheus",
      "targets": [{"expr": "nsga_best_cost_per_1k", "refId": "A"}],
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 10}
    },
    {
      "type": "stat",
      "title": "Melhor Qualidade (NSGA) [0–10]",
      "datasource": "Prometheus",
      "targets": [{"expr": "nsga_best_quality", "refId": "A"}],
      "gridPos": {"h": 6, "w": 4, "x": 20, "y": 10}
    },
    {
      "type": "row",
      "title": "Bandit Contextual",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Seleções por Modelo (Bandit)",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum by(model) (increase(bandit_select_total[15m]))", "legendFormat": "{{model}}", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}
    },
    {
      "type": "timeseries",
      "title": "Reward Observado",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(bandit_reward_sum[5m]) / rate(bandit_reward_count[5m])", "legendFormat": "reward médio", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}
    },
    {
      "type": "row",
      "title": "Router KPIs",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "panels": []
    },
    {
      "type": "stat",
      "title": "Qualidade Média (Router)",
      "datasource": "Prometheus",
      "targets": [{"expr": "avg(ROUTER_QUALITY_AVG)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Custo por Query",
      "datasource": "Prometheus",
      "targets": [{"expr": "ROUTER_COST_PER_QUERY", "refId": "A"}],
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 26}
    },
    {
      "type": "timeseries",
      "title": "Uso Local (Ollama) — Ratio",
      "datasource": "Prometheus",
      "targets": [{"expr": "ROUTER_LOCAL_USAGE_RATIO", "refId": "A"}],
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 26}
    }
  ],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"}
}

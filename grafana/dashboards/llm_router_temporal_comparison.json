{
  "id": null,
  "uid": "llm-router-temporal-comparison",
  "title": "LLM Router — Comparativo Temporal",
  "tags": ["llm", "router", "nsga", "time-comparison"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Modelo",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(model_latency_seconds_avg, model)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "judge",
        "label": "Juiz",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(judge_quality_score_mean, judge)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "interval_ref",
        "label": "Intervalo de Referência",
        "type": "custom",
        "query": "24h,48h,7d,30d",
        "current": { "text": "7d", "value": "7d" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "📊 Comparativo Temporal de Desempenho",
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "⏱️ Latência Média — Últimas 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(model_latency_seconds_avg{model=~\"$model\"}[24h])",
          "legendFormat": "Últimas 24h - {{model}}"
        },
        {
          "expr": "avg_over_time(model_latency_seconds_avg{model=~\"$model\"}[$interval_ref])",
          "legendFormat": "$interval_ref - {{model}}"
        }
      ],
      "gridPos": { "x": 0, "y": 1, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "💰 Custo Médio por 1k tokens — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(model_cost_usd{model=~\"$model\"}[24h])",
          "legendFormat": "Últimas 24h - {{model}}"
        },
        {
          "expr": "avg_over_time(model_cost_usd{model=~\"$model\"}[$interval_ref])",
          "legendFormat": "$interval_ref - {{model}}"
        }
      ],
      "gridPos": { "x": 9, "y": 1, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "🧠 Nota Média dos Juízes — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(judge_quality_score_mean{judge=~\"$judge\"}[24h])",
          "legendFormat": "Últimas 24h - {{judge}}"
        },
        {
          "expr": "avg_over_time(judge_quality_score_mean{judge=~\"$judge\"}[$interval_ref])",
          "legendFormat": "$interval_ref - {{judge}}"
        }
      ],
      "gridPos": { "x": 0, "y": 7, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "⚙️ Pesos NSGA-II — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(nsga_weight_current{model=~\"$model\"}[24h])",
          "legendFormat": "Últimas 24h - {{model}}"
        },
        {
          "expr": "avg_over_time(nsga_weight_current{model=~\"$model\"}[$interval_ref])",
          "legendFormat": "$interval_ref - {{model}}"
        }
      ],
      "gridPos": { "x": 9, "y": 7, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "📈 Fitness Médio — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(nsga_last_fitness_mean[24h])",
          "legendFormat": "Últimas 24h"
        },
        {
          "expr": "avg_over_time(nsga_last_fitness_mean[$interval_ref])",
          "legendFormat": "$interval_ref"
        }
      ],
      "gridPos": { "x": 0, "y": 13, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "🧮 Taxa de Cache HIT/MISS — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "rate(semantic_cache_hits_total[24h])",
          "legendFormat": "HITs (24h)"
        },
        {
          "expr": "rate(semantic_cache_hits_total[$interval_ref])",
          "legendFormat": "HITs ($interval_ref)"
        },
        {
          "expr": "rate(semantic_cache_misses_total[24h])",
          "legendFormat": "MISSes (24h)"
        },
        {
          "expr": "rate(semantic_cache_misses_total[$interval_ref])",
          "legendFormat": "MISSes ($interval_ref)"
        }
      ],
      "gridPos": { "x": 9, "y": 13, "w": 9, "h": 6 }
    },
    {
      "type": "timeseries",
      "title": "🔁 Execução e Convergência NSGA-II — 24h vs $interval_ref",
      "targets": [
        {
          "expr": "avg_over_time(nsga_execution_time_seconds[24h])",
          "legendFormat": "Execução (24h)"
        },
        {
          "expr": "avg_over_time(nsga_execution_time_seconds[$interval_ref])",
          "legendFormat": "Execução ($interval_ref)"
        },
        {
          "expr": "avg_over_time(nsga_convergence_ratio[24h])",
          "legendFormat": "Convergência (24h)"
        },
        {
          "expr": "avg_over_time(nsga_convergence_ratio[$interval_ref])",
          "legendFormat": "Convergência ($interval_ref)"
        }
      ],
      "gridPos": { "x": 0, "y": 19, "w": 18, "h": 6 }
    }
  ]
}

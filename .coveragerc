[run]
source =
    app
# Cobertura de ramos: exigida pelo relatório CRAP (scripts/crap_report.py) e pelo ratchet da CI.
branch = True
omit =
    # Painel Dash (serviço separado, sem testes de UI)
    */dash_control_panel.py
    */utils/bkp.redis_client.py

[report]
show_missing = True
skip_empty = True

# =========================================================
# 🧠 Dockerfile.nsga — Serviço de otimização multiobjetivo
# =========================================================
FROM python:3.11-slim AS base

LABEL maintainer="Jefferson Duarte <jefferson.igorbr@gmail.com>"
LABEL description="NSGA-II Optimizer for LLM Router (Prometheus + Redis + MariaDB)"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# =========================================================
# 📁 Copia os arquivos necessários da aplicação
# =========================================================
COPY ./app /app/app
COPY ./app/requirements.txt /app/requirements.txt

# =========================================================
# 📦 Dependências básicas
# =========================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libmariadb-dev \
    pkg-config \
    curl \
    vim \
    && rm -rf /var/lib/apt/lists/*

# =========================================================
# 🧩 Instala dependências Python
# =========================================================
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt && \
    pip install --no-cache-dir gunicorn python-dotenv

# =========================================================
# ⚙️ Variáveis de ambiente padrão
# =========================================================
ENV PYTHONPATH=/app
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prom/nsga_updater
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379
ENV DB_HOST=mariadb
ENV DB_USER=router_user
ENV DB_PASS=router_pass
ENV DB_NAME=routerdb
ENV DEAP_DEBUG=false

# =========================================================
# 🔧 Script de inicialização
# =========================================================
RUN echo '#!/bin/bash\n\
echo "⏳ Aguardando Banco e Redis..."\n\
until nc -z ${DB_HOST:-mariadb} 3306; do sleep 2; echo "Aguardando MariaDB..."; done\n\
until nc -z ${REDIS_HOST:-redis} ${REDIS_PORT:-6379}; do sleep 2; echo "Aguardando Redis..."; done\n\
echo "✅ Serviços disponíveis, inicializando NSGA-II..."\n\
python /app/app/db_manager.py || echo "⚠️ Banco já sincronizado ou inicialização ignorada."\n\
exec "$@"' > /app/prestart_nsga.sh && chmod +x /app/prestart_nsga.sh

HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD curl -f http://localhost:9999/metrics || exit 1

ENTRYPOINT ["/app/prestart_nsga.sh"]
CMD ["python", "app/app/nsga_weights_updater.py"]

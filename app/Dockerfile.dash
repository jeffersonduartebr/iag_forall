# =========================================================
# 🎛 Dockerfile.dash — Painel de Controle Dash
# =========================================================
FROM python:3.11-slim

LABEL maintainer="Jefferson Duarte <jefferson.igorbr@gmail.com>"
LABEL description="Painel de controle interativo do LLM Router"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
WORKDIR /app

# ---------------------------------------------------------
# 🧰 Dependências de sistema
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libmariadb-dev \
    pkg-config \
    curl \
    netcat-traditional \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# 📦 Copia arquivos da aplicação
# ---------------------------------------------------------
COPY ./app /app/app
COPY ./app/requirements.txt /app/requirements.txt
COPY ./app/prestart_dash.sh /app/prestart_dash.sh

RUN chmod +x /app/prestart_dash.sh

# ---------------------------------------------------------
# 🧩 Instala dependências Python
# ---------------------------------------------------------
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r /app/requirements.txt && \
    pip install dash==2.17.1 dash-bootstrap-components==1.6.0 && \
    pip install gunicorn python-dotenv

# ---------------------------------------------------------
# ⚙️ Variáveis padrão
# ---------------------------------------------------------
ENV REDIS_HOST=redis
ENV DB_HOST=mariadb
ENV DB_USER=router_user
ENV DB_PASS=router_pass
ENV DB_NAME=routerdb
ENV PROM_PORT=8050

# ---------------------------------------------------------
# 🚀 Inicialização (aguarda dependências)
# ---------------------------------------------------------
ENTRYPOINT ["/app/prestart_dash.sh"]
CMD ["python", "app/app/dash_control_panel.py"]

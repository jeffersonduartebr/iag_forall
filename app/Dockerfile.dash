# =========================================================
# 🎛 Dockerfile.dash — Painel de Controle Dash
# =========================================================
FROM python:3.11-slim

LABEL maintainer="Jefferson Duarte <jefferson.igorbr@gmail.com>"
LABEL description="Painel de controle interativo do LLM Router"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
WORKDIR /app

# ---------------------------------------------------------
# 🧰 Dependências de sistema
# ---------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libmariadb-dev \
    pkg-config \
    curl \
    netcat-traditional \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# 📦 Copia arquivos da aplicação
# ---------------------------------------------------------
COPY ./app /app/app
# uv: resolução e instalação a partir de um lock com hash por pacote.
COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /usr/local/bin/uv
COPY ./app/requirements.dash.lock /app/requirements.dash.lock
COPY ./app/prestart_dash.sh /app/prestart_dash.sh

RUN chmod +x /app/prestart_dash.sh

# ---------------------------------------------------------
# 🧩 Instala dependências Python
# ---------------------------------------------------------
RUN uv pip install --system --no-cache --require-hashes -r /app/requirements.dash.lock

# ---------------------------------------------------------
# ⚙️ Variáveis padrão
# ---------------------------------------------------------
ENV REDIS_HOST=redis
ENV DB_HOST=mariadb
ENV DB_USER=router_user
ENV DB_PASS=router_pass
ENV DB_NAME=routerdb
ENV PROM_PORT=8050

ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prom \
    PYTHONUNBUFFERED=1 \
    CHROMA_TELEMETRY_ENABLED=false

# Cria diretório compartilhado de métricas
RUN mkdir -p /tmp/prom && chmod -R 777 /tmp/prom
# ---------------------------------------------------------
# 🚀 Inicialização (aguarda dependências)
# ---------------------------------------------------------
ENTRYPOINT ["/app/prestart_dash.sh"]
CMD ["python", "app/app/dash_control_panel.py"]

# ============================================================
# 🧩 Dockerfile.env_migrator
# ------------------------------------------------------------
# Imagem minimalista para executar a migração do .env → banco
# Executa apenas o script migrate_env_to_db.py
# ============================================================

FROM python:3.11-slim

LABEL maintainer="Jefferson Duarte <jefferson.duarte@academico.ifrn.edu.br>"
LABEL description="Container para migração automática das variáveis .env para o banco MariaDB"

# ------------------------------------------------------------
# Instala dependências mínimas do sistema
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Cria diretório de trabalho
# ------------------------------------------------------------
WORKDIR /app

# ------------------------------------------------------------
# Copia apenas o essencial
# ------------------------------------------------------------
COPY ./app/migrate_env_to_db.py /app/migrate_env_to_db.py
COPY ./app/requirements.txt /app/requirements.txt

# ------------------------------------------------------------
# Instala apenas os pacotes necessários
# ------------------------------------------------------------
RUN pip install --no-cache-dir \
    sqlalchemy \
    pymysql \
    python-dotenv \
    && echo "✅ Dependências essenciais instaladas."

# ------------------------------------------------------------
# Comando padrão — pode ser sobrescrito no docker-compose
# ------------------------------------------------------------
CMD ["python", "app/migrate_env_to_db.py"]
# ============================================================
# Core
ADMIN_TOKEN=replace-with-strong-random-token
ENV=development

# Admin Web Console (http://localhost:8082)
ADMIN_UI_USERNAME=jefferson.silva
ADMIN_UI_PASSWORD=change-me-strong-password
ADMIN_UI_SESSION_TTL_S=28800
ADMIN_UI_CORS_ORIGINS=http://localhost:5173,http://localhost:8082,http://127.0.0.1:8082

# ROI dashboard — contrafactual savings vs premium baseline
ROI_BASELINE_MODEL=openai/gpt-4o
ROI_QUALITY_THRESHOLD=6.0
# Cadastre especialistas pela interface admin em /experts (recomendado).
# Contas legadas via env ainda funcionam como fallback:
EXPERT_UI_USERS={"legacy.expert":"change-me"}
EXPERT_UI_SESSION_TTL_S=28800
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

# API Authentication
REQUIRE_API_AUTH=0
API_KEYS=
JWT_SECRET=replace-with-strong-jwt-secret
METRICS_TOKEN=
TRUSTED_PROXY_IPS=
TRUST_HEADER_ROLES=0
ENFORCE_TENANT_BINDING=1
ROADMAP_AUTO_DDL=1

# Production scale (enable in prod)
REDIS_REQUIRED_IN_PRODUCTION=1
BACKPRESSURE_REDIS_ENABLED=0
TENANT_RATE_LIMIT_ENABLED=1
TENANT_RATE_LIMIT_RPM=120
TENANT_RATE_LIMIT_WINDOW_S=60
REDIS_DEDUP_ENABLED=1
CHROMA_HOST=
CHROMA_PORT=8000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=iag-router-api

# Database
DB_HOST=mariadb
DB_PORT=3306
DB_USER=router_user
DB_PASS=change-me
DB_NAME=routerdb
MYSQL_ROOT_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me

# Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=iag-forall-router
OLLAMA_HOST=http://ollama:11434
OLLAMA_CONCURRENCY_LIMIT=5
OLLAMA_DYNAMIC_CONCURRENCY_ENABLED=0
OLLAMA_CONCURRENCY_MIN=1
OLLAMA_CONCURRENCY_MAX=5
OLLAMA_VRAM_TARGET_UTILIZATION=0.72
OLLAMA_VRAM_HIGH_WATERMARK=0.82
OLLAMA_VRAM_LOW_WATERMARK=0.55
OLLAMA_VRAM_POLL_INTERVAL_SECONDS=5
OLLAMA_CONCURRENCY_STEP_UP=1
OLLAMA_CONCURRENCY_STEP_DOWN=1
OLLAMA_CONCURRENCY_STABLE_WINDOWS=3
OLLAMA_GPU_INDEX=0

# Routing — candidate models for the router (JSON array)
# Dev cloud-only (docker-compose.dev.yml):
# CANDIDATE_MODELS_LIST=["openrouter/openai/gpt-4o-mini","openrouter/anthropic/claude-3.5-haiku"]
# CANDIDATE_MODELS_LIST=["openrouter/anthropic/claude-sonnet-4","openrouter/openai/gpt-4o-mini"]

# Tool/function calling: modelos habilitados quando a requisição traz `tools`.
# Se vazio, o roteador infere a capacidade (registry + supported_parameters do
# OpenRouter). Requisições com `tools` sem nenhum modelo capaz retornam HTTP 422.
# CANDIDATE_TOOL_MODELS_LIST=["openai/gpt-4o-mini","openrouter/anthropic/claude-3.5-sonnet","ollama/qwen2.5"]

# OpenRouter catalog exploration (discover models outside candidate list)
OPENROUTER_EXPLORATION_ENABLED=0
OPENROUTER_EXPLORATION_RATE=0.10
OPENROUTER_EXPLORATION_MAX_PER_DAY=100
OPENROUTER_EXPLORATION_MAX_PRICE_PROMPT_1K=0.01
OPENROUTER_EXPLORATION_MAX_PRICE_COMPLETION_1K=0.03
OPENROUTER_EXPLORATION_PROMOTE_MIN_SAMPLES=15
OPENROUTER_EXPLORATION_PROMOTE_MIN_REWARD=0.72
OPENROUTER_EXPLORATION_PROVIDER_ALLOWLIST=["anthropic","openai","google","meta-llama","mistralai"]
OPENROUTER_EXPLORATION_POOL_SIZE=40

# Docker dev profile (low resources, cloud-only — no Ollama)
# ./scripts/compose-dev.sh up -d --build
MARIADB_BUFFER_POOL=512M

# Runtime
REQUEST_TIMEOUT_SECONDS=120
READINESS_MODE=strict
STATE_DIR=/app/state
PROMETHEUS_WIPE_ON_STARTUP=0
HOTPATH_POLICY_CACHE_TTL_S=30
HOTPATH_TENANT_BUDGET_CACHE_TTL_S=60
HOTPATH_TENANT_USAGE_CACHE_TTL_S=5
